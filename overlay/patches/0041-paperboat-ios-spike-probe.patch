+
+extern "C" {
+int PBIos_ThermalState(void);
+int PBIos_PowerState(void); // shell: 1 LPM, 2 charging, 4 full, 8 unknown
+extern volatile int gPBIosSubframesPerTick; // overlay 0012 rev 9
+void PBIos_PaceSnapshot(unsigned long long* dropped, unsigned long long* dropTicks, unsigned long long* keys,
+                        double* debtSum, double* debtMax, double* lagSum, double* lagMax, double* keyIntMax,
+                        int* enabled, int* stressMs, unsigned int* upstreamSkips);
+}
+
+namespace {
+
+constexpr int kCats = 7;
+const char* const kCatName[kCats] = { "res", "fbrd", "ev", "pump", "si", "cvsave", "idle" };
+constexpr int kIdleCat = 6;
+constexpr int kMenuBuckets = 8;
+const char* const kMenuName[kMenuBuckets] = { "nf", "wm", "ig", "dock", "bar", "menu", "win", "vp" };
+constexpr double kWindowS = 10.0;
+constexpr int kMaxSpikeLines = 20;
+
+double gTickToMs = 0.0;
+bool gEnabled = true;
+int gFramesSinceCVar = 0;
+
+double TicksToMs(uint64_t t) {
+    if (gTickToMs == 0.0) {
+        mach_timebase_info_data_t tb;
+        mach_timebase_info(&tb);
+        gTickToMs = (double)tb.numer / (double)tb.denom / 1e6;
+    }
+    return (double)t * gTickToMs;
+}
+
+double ThreadCpuMs() {
+    timespec ts;
+    clock_gettime(CLOCK_THREAD_CPUTIME_ID, &ts);
+    return ts.tv_sec * 1000.0 + ts.tv_nsec / 1e6;
+}
+
+struct SpkFrame {
+    uint64_t begin = 0, drawB = 0, drawE = 0, mark[3] = { 0, 0, 0 }, sleepB = 0, sleepE = 0;
+    double catMs[kCats] = {};
+    uint32_t catN[kCats] = {};
+    double menuMs[kMenuBuckets] = {};
+    double menuCpu[kMenuBuckets] = {};
+};
+
+struct SpkWindow {
+    std::vector<double> cpu, wait, busy, sleep;
+    uint32_t frames = 0, spikes = 0, spikeLinesDropped = 0, spikeLines = 0;
+    double splitAll[7] = {}, splitSpk[7] = {}; // gap idle wait menu run gui end
+    double catMs[kCats] = {}, catSpkMs[kCats] = {};
+    uint32_t catN[kCats] = {};
+    double menuMs[kMenuBuckets] = {}, menuCpu[kMenuBuckets] = {}, menuMax = 0.0;
+    struct Win {
+        std::string name;
+        double ms = 0.0, max = 0.0;
+        uint32_t n = 0;
+    };
+    std::vector<Win> wins;
+    uint64_t start = 0;
+    unsigned long long lastDropped = 0, lastDropTicks = 0, lastKeys = 0;
+    unsigned int lastUpSkips = 0;
+};
+
+SpkFrame gFrame;
+SpkWindow gWin;
+uint64_t gPrevEnd = 0;
+bool gInFrame = false;
+uint64_t gMenuLast = 0;
+double gMenuCpuLast = 0.0;
+uint64_t gWinT0 = 0;
+
+bool OnMain() {
+    return pthread_main_np() != 0;
+}
+
+double Pct(std::vector<double>& v, double p) {
+    if (v.empty()) {
+        return 0.0;
+    }
+    return v[(size_t)(p * (double)(v.size() - 1))];
+}
+
+void Flush(uint64_t now) {
+    const double el = TicksToMs(now - gWin.start) / 1000.0;
+    if (gWin.start == 0) {
+        gWin.start = now;
+        return;
+    }
+    if (el < kWindowS || gWin.frames < 8) {
+        return;
+    }
+    for (auto* v : { &gWin.cpu, &gWin.wait, &gWin.busy, &gWin.sleep }) {
+        std::sort(v->begin(), v->end());
+    }
+    const double n = (double)gWin.frames;
+    const double ns = gWin.spikes > 0 ? (double)gWin.spikes : 1.0;
+
+    // PB_PACE: key-frame cadence + catch-up (0012 rev 9), frame split percentiles.
+    unsigned long long dropped = 0, dropTicks = 0, keys = 0;
+    double debtSum = 0, debtMax = 0, lagSum = 0, lagMax = 0, keyIntMax = 0;
+    int enabled = 0, stress = 0;
+    unsigned int upSkips = 0;
+    PBIos_PaceSnapshot(&dropped, &dropTicks, &keys, &debtSum, &debtMax, &lagSum, &lagMax, &keyIntMax, &enabled,
+                       &stress, &upSkips);
+    const unsigned long long dKeys = keys - gWin.lastKeys;
+    const double kn = dKeys > 0 ? (double)dKeys : 1.0;
+    SPDLOG_INFO("PB_PACE tps={:.2f} keys={} ipf={} fps={:.1f} key_int_max={:.1f} lag_avg={:.2f} lag_max={:.2f} "
+                "dropped={} drop_ticks={} upstream_skips={} late_avg={:.2f} late_max={:.2f} "
+                "wait_ms p50={:.2f} p95={:.2f} max={:.2f} busy_ms p50={:.2f} p95={:.2f} max={:.2f} "
+                "sleep_ms p50={:.2f} p95={:.2f} catchup={} stress={} thermal={} power={}",
+                dKeys / el, dKeys, (int)gPBIosSubframesPerTick, n / el, keyIntMax, lagSum / kn, lagMax,
+                dropped - gWin.lastDropped, dropTicks - gWin.lastDropTicks, upSkips - gWin.lastUpSkips,
+                debtSum / kn, debtMax, Pct(gWin.wait, 0.5), Pct(gWin.wait, 0.95),
+                gWin.wait.empty() ? 0.0 : gWin.wait.back(), Pct(gWin.busy, 0.5), Pct(gWin.busy, 0.95),
+                gWin.busy.empty() ? 0.0 : gWin.busy.back(), Pct(gWin.sleep, 0.5), Pct(gWin.sleep, 0.95), enabled,
+                stress, PBIos_ThermalState(), PBIos_PowerState());
+
+    // PB_SPKWIN
+    char cats[640];
+    int off = 0;
+    for (int c = 0; c < kCats; c++) {
+        off += snprintf(cats + off, sizeof(cats) - off, " %s=%u/%.1f/%.1f", kCatName[c], gWin.catN[c], gWin.catMs[c],
+                        gWin.catSpkMs[c]);
+        if (off >= (int)sizeof(cats)) {
+            break;
+        }
+    }
+    SPDLOG_INFO("PB_SPKWIN s={:.1f} frames={} spikes={} spike_lines_dropped={} period_ms={:.2f} cpu_ms p50={:.2f} "
+                "p95={:.2f} max={:.2f} all(gap/idle/wait/menu/run/gui/end)={:.2f}/{:.2f}/{:.2f}/{:.2f}/{:.2f}/{:.2f}/"
+                "{:.2f} spk={:.2f}/{:.2f}/{:.2f}/{:.2f}/{:.2f}/{:.2f}/{:.2f} cats(n/ms/spk_ms):{} thermal={}",
+                el, gWin.frames, gWin.spikes, gWin.spikeLinesDropped,
+                1000.0 / (30.0 * std::max(1, (int)gPBIosSubframesPerTick)), Pct(gWin.cpu, 0.5),
+                Pct(gWin.cpu, 0.95), gWin.cpu.empty() ? 0.0 : gWin.cpu.back(), gWin.splitAll[0] / n,
+                gWin.splitAll[1] / n, gWin.splitAll[2] / n, gWin.splitAll[3] / n, gWin.splitAll[4] / n,
+                gWin.splitAll[5] / n, gWin.splitAll[6] / n, gWin.splitSpk[0] / ns, gWin.splitSpk[1] / ns,
+                gWin.splitSpk[2] / ns, gWin.splitSpk[3] / ns, gWin.splitSpk[4] / ns, gWin.splitSpk[5] / ns,
+                gWin.splitSpk[6] / ns, cats, PBIos_ThermalState());
+
+    // PB_MENUWIN
+    char mb[512];
+    off = 0;
+    for (int b = 0; b < kMenuBuckets; b++) {
+        off += snprintf(mb + off, sizeof(mb) - off, " %s=%.1f/%.1f", kMenuName[b], gWin.menuMs[b], gWin.menuCpu[b]);
+        if (off >= (int)sizeof(mb)) {
+            break;
+        }
+    }
+    std::sort(gWin.wins.begin(), gWin.wins.end(), [](const SpkWindow::Win& a, const SpkWindow::Win& b) { return a.ms > b.ms; });
+    char top[384];
+    off = 0;
+    top[0] = 0;
+    for (size_t i = 0; i < gWin.wins.size() && i < 3; i++) {
+        off += snprintf(top + off, sizeof(top) - off, " %s:%u/%.1f/max%.2f", gWin.wins[i].name.c_str(), gWin.wins[i].n,
+                        gWin.wins[i].ms, gWin.wins[i].max);
+        if (off >= (int)sizeof(top)) {
+            break;
+        }
+    }
+    SPDLOG_INFO("PB_MENUWIN s={:.1f} frames={} menu_max={:.2f} buckets(wall/cpu ms):{} top_windows(n/ms):{}", el,
+                gWin.frames, gWin.menuMax, mb, top);
+
+    const unsigned long long keepDropped = dropped, keepDropTicks = dropTicks, keepKeys = keys;
+    const unsigned int keepUp = upSkips;
+    gWin = SpkWindow();
+    gWin.start = now;
+    gWin.lastDropped = keepDropped;
+    gWin.lastDropTicks = keepDropTicks;
+    gWin.lastKeys = keepKeys;
+    gWin.lastUpSkips = keepUp;
+}
+
+} // namespace
+
+extern "C" unsigned long long PBIos_SpkNow(void) {
+    if (!gEnabled || !OnMain()) {
+        return 0;
+    }
+    return mach_absolute_time();
+}
+
+extern "C" void PBIos_SpkAdd(int cat, unsigned long long t0) {
+    if (t0 == 0 || cat < 0 || cat >= kCats) {
+        return;
+    }
+    const double ms = TicksToMs(mach_absolute_time() - t0);
+    gFrame.catMs[cat] += ms;
+    gFrame.catN[cat]++;
+}
+
+// Fast3dWindow::DrawAndRunGraphicsCommands, after its visibility check.
+extern "C" void PBIos_SpkFrameBegin(void) {
+    if (++gFramesSinceCVar >= 60) {
+        gFramesSinceCVar = 0;
+        gEnabled = CVarGetInteger("gSohIos.SpikeProbe", 1) != 0;
+    }
+    if (!gEnabled) {
+        gInFrame = false;
+        return;
+    }
+    const uint64_t now = mach_absolute_time();
+    gFrame.begin = now;
+    gFrame.drawB = gFrame.drawE = gFrame.sleepB = gFrame.sleepE = 0;
+    gFrame.mark[0] = gFrame.mark[1] = gFrame.mark[2] = 0;
+    gMenuLast = now;
+    gMenuCpuLast = ThreadCpuMs();
+    gInFrame = true;
+}
+
+// Menu-phase split (Gui::StartFrame / Gui::DrawMenu): the time since the
+// previous mark goes to `bucket`.
+extern "C" void PBIos_MenuMark(int bucket) {
+    if (!gInFrame || bucket < 0 || bucket >= kMenuBuckets) {
+        return;
+    }
+    const uint64_t now = mach_absolute_time();
+    const double cpu = ThreadCpuMs();
+    gFrame.menuMs[bucket] += TicksToMs(now - gMenuLast);
+    gFrame.menuCpu[bucket] += cpu - gMenuCpuLast;
+    gMenuLast = now;
+    gMenuCpuLast = cpu;
+}
+
+extern "C" void PBIos_MenuWinBegin(void) {
+    gWinT0 = gInFrame ? mach_absolute_time() : 0;
+}
+
+extern "C" void PBIos_MenuWinEnd(const char* name) {
+    if (gWinT0 == 0 || name == nullptr) {
+        return;
+    }
+    const double ms = TicksToMs(mach_absolute_time() - gWinT0);
+    gWinT0 = 0;
+    for (auto& w : gWin.wins) {
+        if (w.name == name) {
+            w.ms += ms;
+            w.max = std::max(w.max, ms);
+            w.n++;
+            return;
+        }
+    }
+    gWin.wins.push_back({ name, ms, ms, 1 });
+}
+
+extern "C" void PBIos_PaceDrawableBegin(void) {
+    if (gInFrame) {
+        gFrame.drawB = mach_absolute_time();
+    }
+}
+
+extern "C" void PBIos_PaceDrawableEnd(void) {
+    if (gInFrame) {
+        gFrame.drawE = mach_absolute_time();
+    }
+}
+
+extern "C" void PBIos_PaceSleepBegin(void) {
+    if (gInFrame) {
+        gFrame.sleepB = mach_absolute_time();
+    }
+}
+
+extern "C" void PBIos_PaceSleepEnd(void) {
+    if (gInFrame) {
+        gFrame.sleepE = mach_absolute_time();
+    }
+}
+
+// 0 = Gui::StartDraw returned, 1 = Interpreter::Run returned, 2 = Gui::EndDraw returned.
+extern "C" void PBIos_SpkMark(int which) {
+    if (!gInFrame || which < 0 || which > 2) {
+        return;
+    }
+    gFrame.mark[which] = mach_absolute_time();
+    if (which == 0) {
+        PBIos_MenuMark(7); // vp: last DrawMenu mark -> StartDraw returned
+    }
+}
+
+// After Interpreter::EndFrame (present + pacer sleep).
+extern "C" void PBIos_SpkFrameEnd(void) {
+    if (!gInFrame) {
+        return;
+    }
+    gInFrame = false;
+    const uint64_t now = mach_absolute_time();
+    SpkFrame& f = gFrame;
+    if (f.mark[0] == 0 || f.mark[1] == 0 || f.mark[2] == 0) {
+        gPrevEnd = now;
+        gFrame = SpkFrame();
+        return;
+    }
+    const double gap = gPrevEnd != 0 ? TicksToMs(f.begin - gPrevEnd) : 0.0;
+    const double idle = std::min(gap, f.catMs[kIdleCat]);
+    const double wait = (f.drawB != 0 && f.drawE >= f.drawB) ? TicksToMs(f.drawE - f.drawB) : 0.0;
+    const double sleep = (f.sleepB != 0 && f.sleepE >= f.sleepB) ? TicksToMs(f.sleepE - f.sleepB) : 0.0;
+    const double menu = std::max(0.0, TicksToMs(f.mark[0] - f.begin) - wait);
+    const double run = TicksToMs(f.mark[1] - f.mark[0]);
+    const double gui = TicksToMs(f.mark[2] - f.mark[1]);
+    const double end = std::max(0.0, TicksToMs(now - f.mark[2]) - sleep);
+    const double cpu = (gap - idle) + menu + run + gui + end;
+    const double busy = menu + run + gui + end;
+    const double period = 1000.0 / (30.0 * std::max(1, (int)gPBIosSubframesPerTick));
+    const bool spike = cpu > period;
+    // `nf` holds the drawable wait (it happens inside the backend NewFrame); take it out.
+    f.menuMs[0] = std::max(0.0, f.menuMs[0] - wait);
+
+    gWin.frames++;
+    gWin.cpu.push_back(cpu);
+    gWin.wait.push_back(wait);
+    gWin.busy.push_back(busy);
+    gWin.sleep.push_back(sleep);
+    const double split[7] = { gap - idle, idle, wait, menu, run, gui, end };
+    for (int i = 0; i < 7; i++) {
+        gWin.splitAll[i] += split[i];
+        if (spike) {
+            gWin.splitSpk[i] += split[i];
+        }
+    }
+    for (int c = 0; c < kCats; c++) {
+        gWin.catMs[c] += f.catMs[c];
+        gWin.catN[c] += f.catN[c];
+        if (spike) {
+            gWin.catSpkMs[c] += f.catMs[c];
+        }
+    }
+    double menuTotal = 0.0;
+    for (int b = 0; b < kMenuBuckets; b++) {
+        gWin.menuMs[b] += f.menuMs[b];
+        gWin.menuCpu[b] += f.menuCpu[b];
+        menuTotal += f.menuMs[b];
+    }
+    gWin.menuMax = std::max(gWin.menuMax, menuTotal);
+    if (spike) {
+        gWin.spikes++;
+        if (gWin.spikeLines < kMaxSpikeLines) {
+            gWin.spikeLines++;
+            char cats[384];
+            int off = 0;
+            cats[0] = 0;
+            for (int c = 0; c < kCats; c++) {
+                if (f.catN[c] > 0) {
+                    off += snprintf(cats + off, sizeof(cats) - off, " %s=%u/%.2f", kCatName[c], f.catN[c], f.catMs[c]);
+                    if (off >= (int)sizeof(cats)) {
+                        break;
+                    }
+                }
+            }
+            char mb[384];
+            off = 0;
+            mb[0] = 0;
+            for (int b = 0; b < kMenuBuckets; b++) {
+                if (f.menuMs[b] >= 0.5) {
+                    off += snprintf(mb + off, sizeof(mb) - off, " %s=%.2f/%.2f", kMenuName[b], f.menuMs[b], f.menuCpu[b]);
+                    if (off >= (int)sizeof(mb)) {
+                        break;
+                    }
+                }
+            }
+            SPDLOG_INFO("PB_SPIKE cpu={:.2f} period={:.2f} gap={:.2f} idle={:.2f} wait={:.2f} menu={:.2f} run={:.2f} "
+                        "gui={:.2f} end={:.2f} sleep={:.2f}{} menu_split:{}",
+                        cpu, period, gap - idle, idle, wait, menu, run, gui, end, sleep, cats, mb);
+        } else {
+            gWin.spikeLinesDropped++;
+        }
+    }
+    gPrevEnd = now;
+    gFrame = SpkFrame();
+    Flush(now);
+}
+
+#endif // __IOS__
