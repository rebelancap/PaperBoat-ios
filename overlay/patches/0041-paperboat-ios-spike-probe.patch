+// PAPERBOAT_IOS (overlay 0041, D40): SPIKE ATTRIBUTION PROBE + PACE LINE.
+// Port of Shipwright 0065's SOH_PACE + 0066/0068's spike probe and menu split
+// (D-084/D-085/D-087) to PaperBoat's threaded engine. iOS only; the whole file
+// compiles to nothing elsewhere. Source of truth: overlay/files/PBIosSpikeProbe.cpp.
+//
+// THE FRAME (main thread = the render loop on iOS; the game ticks on the nusys
+// gfx thread, so a slow TICK shows up here as a late task, not a long frame):
+//   gap    previous frame's end -> this frame's DrawAndRunGraphicsCommands.
+//          Holds the main loop: waiting for the next task (idle, NOT cpu),
+//          OS_SiService (si: controller read incl. an SDL pump), ServiceRcp,
+//          FrameInterpolation, RunCommands' HandleEvents pump (ev).
+//   wait   nextDrawable (SetupScreenFramebuffer inside Metal NewFrame).
+//   menu   Gui::StartDraw minus wait: ImGui NewFrame + DrawMenu (every
+//          GuiWindow's Update, incl. LUS's SDLAddRemoveDeviceEventHandler
+//          SDL_PumpEvents = the UIKit run loop = the touch overlay) + viewport.
+//   run    Interpreter::StartFrame + Run (the display list).
+//   gui    Gui::EndDraw (DrawGame, ImGui render, floating windows, cvar save).
+//   end    Interpreter::EndFrame minus the pacer sleep (commit, present).
+//   sleep  LUS's SyncFramerateWithTime nanosleep pacer.
+//   cpu    (gap - idle) + menu + run + gui + end. cpu > the frame period
+//          (1000 / (30 * sub-frames per tick)) is a SPIKE.
+// Seam categories (main thread only, ms + count, also inside spike frames):
+//   0 res    ResourceManager::LoadResource cache MISS waited on (pool load)
+//   1 fbrd   GfxRenderingAPIMetal::ReadFramebufferToCPU (the flame effect's
+//            readback; PM64's only GPU->CPU read - there is no GetPixelDepth)
+//   2 ev     Fast3dWindow::HandleEvents (SDL pump in RunCommands, once a tick)
+//   3 pump   SDLAddRemoveDeviceEventHandler::UpdateElement's SDL_PumpEvents
+//            (every frame, inside `menu`)
+//   4 si     OS_SiService (controller read; ControlDeck pumps SDL too)
+//   5 cvsave Gui::CheckSaveCvars -> ConsoleVariables::Save
+//   6 idle   main loop SDL_Delay(1) while no task is pending (not cpu)
+//
+// OUTPUT (spdlog -> the log file the user's device pull reads), every 10 s:
+//   PB_PACE    key-frame cadence + the 0012 rev 9 catch-up counters (late =
+//              task submit -> its drawing starts), frame
+//              wait/busy/sleep percentiles, thermal + power state
+//   PB_SPKWIN  frames, spikes, cpu p50/p95/max, per-frame split averages over
+//              all frames / spike frames, every category n/ms/ms-in-spikes
+//   PB_SPIKE   one line per spike frame (max 20 per window, rest counted)
+//   PB_MENUWIN the `menu` phase split into eight buckets, wall + thread-cpu,
+//              plus the three costliest GuiWindows by name
+// gSohIos.SpikeProbe (default 1, re-read every 60 frames) switches it off.
+
+#ifdef __IOS__
+
+#include <libultraship.h>
+
+#include <mach/mach_time.h>
+#include <pthread.h>
+#include <time.h>
