+#if defined(PLATFORM_IOS) || defined(__IOS__)
+// PAPERBOAT_IOS (overlay 0013): the app shell's safe-area insets, in DRAWABLE
+// PIXELS — the space this file lays out in, because this fork runs ImGui in
+// drawable pixels on iOS (Fast3dGui sets DisplayFramebufferScale to (1,1) and
+// DisplaySize from SDL_GetRendererOutputSize). Declared at file scope: a
+// linkage specification may not sit inside a function.
+extern "C" void PBIos_GetSafeAreaInsets(float* top, float* left, float* bottom, float* right);
+#endif
+
+// The usable screen rectangle. On iOS the sensor housing and the home
+// indicator carve real estate out of the display in landscape (~59 pt leading,
+// ~21 pt bottom on a modern iPhone), and a control drawn under either is
+// untappable — the bottom one also fights the system's swipe-up gesture.
+// Everywhere else, and on an iOS screen with no insets, this is the full
+// display and every number below is unchanged.
+void SafeRect(float w, float h, float& x0, float& y0, float& x1, float& y1) {
+    x0 = 0.0f;
+    y0 = 0.0f;
+    x1 = w;
+    y1 = h;
+#if defined(PLATFORM_IOS) || defined(__IOS__)
+    float top = 0.0f, left = 0.0f, bottom = 0.0f, right = 0.0f;
+    PBIos_GetSafeAreaInsets(&top, &left, &bottom, &right);
+    // Defensive: a nonsense inset (a window mid-rotation, say) must never
+    // collapse the rect and stack the whole pad in one spot.
+    if (left >= 0.0f && right >= 0.0f && top >= 0.0f && bottom >= 0.0f && (w - left - right) > w * 0.5f &&
+        (h - top - bottom) > h * 0.5f) {
+        x0 = left;
+        y0 = top;
+        x1 = w - right;
+        y1 = h - bottom;
+    }
+#endif
 }
 
+// Maps a DEFAULT position, expressed against the full display, into the safe
+// rect. A linear remap rather than a per-edge nudge: it needs no
+// near-an-edge threshold, it keeps upstream's arrangement intact, and it does
+// the right thing for the centre-anchored elements (Start) instead of having
+// to choose a side for them. With no insets it is the identity.
+ImVec2 SafeDefault(ImVec2 c, float w, float h) {
+    float x0, y0, x1, y1;
+    SafeRect(w, h, x0, y0, x1, y1);
+    if (w > 1.0f && h > 1.0f) {
+        c.x = x0 + c.x * ((x1 - x0) / w);
+        c.y = y0 + c.y * ((y1 - y0) / h);
+    }
+    return c;
+}
+
