+            const float pbF = ((float)pbNativePxW / (float)mCurDimensions.width) * pbSsaa;
+            uint32_t pbW = (uint32_t)(mCurDimensions.width * pbF + 0.5f);
+            uint32_t pbH = (uint32_t)(mCurDimensions.height * pbF + 0.5f);
+            // mGameFb is a texture - clamp uniformly to the backend's maximum.
+            const int pbMax = mRapi->GetMaxTextureSize();
+            if (pbMax > 0 && ((int)pbW > pbMax || (int)pbH > pbMax)) {
+                const float pbClamp = (float)pbMax / (float)(pbW > pbH ? pbW : pbH);
+                pbW = (uint32_t)(pbW * pbClamp);
+                pbH = (uint32_t)(pbH * pbClamp);
