+        for (int i = 0; i < ARRAY_COUNT(prg->pipeline_state_variants); i++) {
+            prg->pipeline_state_variants[i] = prg->pbIosJob->variants[i];
+            // Ownership moves to the entry; the job must not release it.
+            prg->pbIosJob->variants[i] = nullptr;
+        }
+    }
+    prg->pbIosJob.reset();
